# Audio Configuration
AUDIO_INPUT_DEVICE=17
AUDIO_OUTPUT_DEVICE=15
SAMPLE_RATE=48000
BUFFER_SIZE=512

# Web Server Configuration
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Logging
LOG_LEVEL=INFO

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=false

# Optional: TONE3000 API (or paste the key in the app's TONE3000 dialog)
# Publishable key only — never put the t3k_cs_ secret in a client app.
# T3K_CLIENT_ID=t3k_pub_xxxxxxxxxxxxxxxxxxxx
# Must match the redirect URI allowed in tone3000.com/settings.
# T3K_REDIRECT_URI=http://127.0.0.1:8000/api/t3k/callback

# Optional: Custom paths (uncomment to use)
# KEMPER_PACK_DIR=C:\Program Files\Kemper Amps\Rig Manager\Rig Packs
# TONE3000_FACTORY_DIR=C:\ProgramData\TONE3000\Presets\Factory
